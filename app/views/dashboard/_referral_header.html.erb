<section class="rounded-2xl border p-6 text-white shadow-lg sm:p-8" 
         style="background: linear-gradient(135deg, #1e293b 0%, #0f3b5f 55%, #155e75 100%); border-color: #0f4c63;">
  
  <div class="flex md:flex-row gap-8 md:flex-row">
    
    <%# --- Left Section: Info & Referral Code --- %>
    <div class="flex flex-col justify-between space-y-6 w-full md:w-[60%]">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Referral Dashboard</h1>
        <p class="text-sm text-slate-300 sm:text-base">Email: <span class="text-white"><%= user_email %></span></p>
      </div>

      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="space-y-1">
          <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Your referral code</p>
          <p class="text-3xl font-mono font-bold tracking-widest text-white sm:text-4xl"><%= referral_code %></p>
        </div>

        <button type="button"
                data-copy-referral-code
                data-code="<%= referral_code %>"
                class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/20 active:scale-95"
                style="background-color: rgba(148, 163, 184, 0.15); border: 1px solid rgba(148, 163, 184, 0.3); box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <%# --- Vertical Divider (Visible on Desktop) --- %>
    <div class="md:block w-px shrink-0 border rounded-full mx-4"
         style="margin-left: 20px; margin-right: 20px; padding: 4px; border-color: #ffffff; background-color: #ffffff;">
    </div>
    
    <%# --- Horizontal Divider (Visible on Mobile) --- %>
    <%# <div class="md:hidden h-px w-full bg-slate-700/50"></div> %>

    <%# --- Right Section: Balance & Action --- %>
    <div class="shrink-0 w-full md:w-[40%]">
      <div class="flex h-full flex-col justify-center space-y-4">
        <div class="space-y-1">
          <p class="text-sm font-medium text-slate-300">Available balance to withdraw</p>
          <p class="text-4xl font-bold text-white sm:text-5xl"><%= available_balance_display %></p>
        </div>
        
        <button type="button"
           data-open-cashout-modal
           class="inline-flex items-center justify-center rounded-xl bg-blue-600/60 px-6 py-3 text-base font-bold text-white shadow-lg transition hover:bg-blue-600/80 active:translate-y-0.5"
           style="border: 1px solid rgba(59, 130, 246, 0.4); box-shadow: 0 4px 12px rgba(15, 23, 42, 0.4);">
           Withdraw balance
        </button>
      </div>
    </div>

  </div>
</section>
